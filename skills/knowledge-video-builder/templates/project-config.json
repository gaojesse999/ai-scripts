{
  "language": "zh-CN",
  "video": {
    "aspect_ratio": "21:9",
    "width": 2520,
    "height": 1080,
    "fps": 30,
    "target_duration": 240
  },
  "style": {
    "name": "editorial-technical-dark",
    "density": "medium",
    "motion": "semantic",
    "captions": true,
    "reference_profile": "analysis/reference-style-profile.md",
    "tokens": {
      "canvas": "#171917",
      "surface": "#292b29",
      "ink": "#f5f5f0",
      "muted": "#8b9089",
      "accent": "#ff9f0a",
      "danger": "#ff5362",
      "success": "#39d98a"
    }
  },
  "voice": {
    "provider": "mimo-tts",
    "script": ".cursor/skills/mimo-tts/scripts/mimo_tts.py",
    "env_file": ".skill.env",
    "voice": "auto",
    "sample_rate": 48000,
    "channels": 1,
    "instruction": "中文知识分享口播，声音自然、清晰，语速适中，重点处有轻微强调，不夸张",
    "consistency": {
      "candidate_count": 2,
      "max_attempts_per_chunk": 4,
      "target_chars_per_second": 4.6,
      "pace_tolerance_ratio": 0.18,
      "max_adjacent_pace_ratio": 0.15,
      "min_asr_coverage": 0.9,
      "target_lufs": -16,
      "lufs_tolerance": 0.6,
      "true_peak_db": -1.5,
      "target_lra": 7
    },
    "fallback_policy": "only-if-mimo-unavailable"
  },
  "hyperframes": {
    "example": "blank",
    "docker_render": false
  },
  "audio": {
    "segment_pause_seconds": 0.8,
    "scene_gap_seconds": 0.8,
    "exact_pause_plan": "script/voice-plan.json",
    "tts_request_max_seconds": 30,
    "tts_request_target_seconds": 25,
    "tts_planning_min_chars_per_second": 3.2,
    "tts_chunk_pause_seconds": 0.12,
    "purpose": "段间与场间停顿是换气/反应时间，属于设计意图，不是可以压掉的静音。",
    "visual_rule": "场景间停顿期间画面必须保持上一场末帧；scene host 与章节标签按下一场起点排布，不得留空。"
  }
}

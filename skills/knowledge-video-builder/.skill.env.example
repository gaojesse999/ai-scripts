# Keep one copy in the fixed engineering root (the directory containing .cursor/skills)
# as .skill.env. Do not copy it into individual video artifact directories.
# This file is never resolved from the Skill or script directory.
# Never commit a real API key or proxy credential, or send them in chat.
MIMO_API_KEY=your-mimo-api-key
# Required when knowledge-video-builder is active; direct fallback is disabled.
SKILL_PROXY=http://xxx.xxx.xxx.xxx:xxxx
# Optional: leave empty to use standard MiMo synthesis.
# Relative paths are resolved from the fixed engineering root.
# Example: MIMO_REFERENCE_VOICE=reference-voice/my-teacher-voice.wav
# Example: MIMO_REFERENCE_VOICE=reference-voice/female-narrator.mp3
MIMO_REFERENCE_VOICE=

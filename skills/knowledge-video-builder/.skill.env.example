# Keep one copy in the fixed engineering root - the project root that contains
# the <SKILLS_ROOT> directory - as .skill.env. Do not copy it into individual
# video artifact directories.
# This file is never resolved from the Skill or script directory.
# Never commit a real API key or proxy credential, or send them in chat.
MIMO_API_KEY=your-mimo-api-key
# Required: speech recognition for forced alignment and candidate scoring.
# There is no local recogniser; without this key Phase 4 cannot run.
GROQ_API_KEY=your-groq-api-key
# Optional. Leave empty to connect directly. When set, every Skill network call
# (MiMo TTS, Groq recognition, npx, browser downloads) goes through it and there
# is no direct fallback.
# Example: SKILL_PROXY=http://10.0.0.1:8080
SKILL_PROXY=
# Optional: leave empty to use standard MiMo synthesis.
# Relative paths are resolved from the fixed engineering root.
# Example: MIMO_REFERENCE_VOICE=reference-voice/my-teacher-voice.wav
# Example: MIMO_REFERENCE_VOICE=reference-voice/female-narrator.mp3
MIMO_REFERENCE_VOICE=

# ---- Voice pace gate -----------------------------------------------------
# The accepted speaking rate for TTS takes, in characters per second. It has to
# match the reference voice named above, so it is configured here rather than per
# project. Two accepted forms:
#   TTS_PACE_RANGE=3.8,7.9   an explicit window
#   TTS_PACE_RANGE=5.85      this voice speaks at 5.85 chars/s; the window is that
#                            rate +/-35%, the provider's measured spread
# Either form sets the target, the absolute window and the adjacent window
# together, so they cannot drift apart. Re-measure after changing the voice with
# scripts/../tools/measure_reference_pace.py, which prints the rate to paste here.
# Leave unset to fall back to voice.consistency in project-config.json.
TTS_PACE_RANGE=

# ---- Skill directory and interpreter -------------------------------------
# Engineering-level Skill directory, relative to this project root.
# Change only when porting the Skill to another agent.
#   Cursor -> .cursor/skills    Claude Code -> .claude/skills
SKILLS_ROOT=.workbuddy/skills
# Python interpreter used by the Skill scripts. Must ship numpy
# (align_audio.py) and be Python >= 3.9. Leave empty to fall back to the
# launching interpreter (sys.executable), then to python3 on PATH.
PYTHON_EXE=

# Copy this file to the project root as .mimo.env and replace the value locally.
# Never commit the real .mimo.env or send the API key in chat.
MIMO_API_KEY=your-mimo-api-key
# Optional: omit or leave empty to connect directly.
MIMO_PROXY=http://xxx.xxx.xxx.xxx:xxxx
# Optional: leave empty to use standard MiMo synthesis.
# Relative paths are resolved from the project root.
# Example: MIMO_REFERENCE_VOICE=reference-voice/my-teacher-voice.wav
# Example: MIMO_REFERENCE_VOICE=reference-voice/female-narrator.mp3
MIMO_REFERENCE_VOICE=

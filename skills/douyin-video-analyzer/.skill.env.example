# ==============================================================================
# douyin-video-analyzer Skill 配置模板（.skill.env.example）
#
# 本技能复用工程根目录统一的 .skill.env（video-to-mp3 / audio-stt 也读它）。
# 复制到工程根目录命名为 .skill.env 后填写；切勿将含真实密钥的 .skill.env 提交 Git。
# ==============================================================================

# [必填] Groq Cloud API Key（用于 audio-stt 的 Whisper 语音转写）
# 免费申请：https://console.groq.com/keys （gsk_ 开头）
GROQ_API_KEY=your-groq-api-key

# [必填] 执行脚本的 Python 解释器绝对路径（需 >=3.9 且已安装 openpyxl）
# 示例（Windows）：PYTHON_EXE=D:/Programs/CondaData/envs/QuantTrading/python.exe
# 若用默认环境：pip install openpyxl
PYTHON_EXE=

# [选填] ffmpeg 路径；留空则使用系统 PATH 中的 ffmpeg
# 需同时有 ffmpeg 与 ffprobe（同一 bin 目录）
# 示例：FFMPEG_PATH=D:/Programs/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=

# [选填] 访问 Groq 的代理；实测直连 api.groq.com 通常无需代理，留空即可
# 受阻时再配，例如：SKILL_PROXY=http://127.0.0.1:7890
SKILL_PROXY=

# [选填] 素材根目录；留空默认为 <工程根>/视频分析/视频素材
# 报告与素材默认都放在工程内的“视频分析”目录，不进入 Obsidian 知识库。
MATERIALS_ROOT=

# [选填] 前台自动化浏览器路径（Windows 系统专享；留空自动探测 Edge / Chrome 默认路径）
# 示例：EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
EDGE_PATH=
